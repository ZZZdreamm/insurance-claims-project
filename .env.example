# copy to .env; docker compose reads it automatically
# turn on trace export + Loki log shipping when the observability profile is running
TRACING_ENABLED=true
LOKI_URL=http://loki:3100
ASSESSMENT_OTEL_ENDPOINT=http://tempo:4318
# security: HS256 secret shared by claim/payout/search-service (>= 32 bytes) and the machine account
# assessment-service uses to read photos. Change both before exposing anything.
AUTH_JWT_SECRET=dev-only-secret-change-me-please-32-bytes-minimum
SERVICE_ACCOUNT_PASSWORD=assessment-secret
# traces from a process running on the host (e.g. mvn spring-boot:run) go to the mapped Tempo port
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
