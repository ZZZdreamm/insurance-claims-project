<?xml version="1.0" encoding="UTF-8"?>
<!-- Included by every service's logback-spring.xml. Console always; Loki only when LOKI_URL is set
     (the appender validates its URL at construction). Labels stay low-cardinality; the trace id goes
     into the line so Grafana can derive a link to Tempo. -->
<included>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <springProperty scope="context" name="app" source="spring.application.name" defaultValue="service"/>
  <springProperty scope="context" name="lokiUrl" source="logging.loki.url" defaultValue=""/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${CONSOLE_LOG_PATTERN}</pattern></encoder>
  </appender>

  <if condition='!property("lokiUrl").isEmpty()'>
    <then>
      <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http><url>${lokiUrl}/loki/api/v1/push</url></http>
        <format>
          <label><pattern>app=${app},level=%level</pattern></label>
          <message><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} traceId=%X{traceId:-} spanId=%X{spanId:-} - %msg%n%ex</pattern></message>
        </format>
      </appender>
      <root level="INFO"><appender-ref ref="LOKI"/></root>
    </then>
  </if>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</included>
